services:
  qdrant:
    image: qdrant/qdrant:v1.12.6
    container_name: ${COMPOSE_PROJECT}-qdrant
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - qdrant-data:/qdrant/storage
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    # The image carries no curl or wget, so probe the port with bash's
    # /dev/tcp builtin. bash must be invoked explicitly: CMD-SHELL means
    # `/bin/sh -c`, /bin/sh is dash here, and /dev/tcp is a bash builtin
    # dash does not implement — under CMD-SHELL every probe fails with
    # "cannot create /dev/tcp/...: Directory nonexistent" and the service
    # reports unhealthy forever while serving perfectly.
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/6333"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

  neo4j:
    image: neo4j:5.26-community
    container_name: ${COMPOSE_PROJECT}-neo4j
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      - NEO4J_AUTH=neo4j/${NEO4J_PASSWORD}
      - NEO4J_server_memory_heap_initial__size=256m
      - NEO4J_server_memory_heap_max__size=512m
      - NEO4J_server_memory_pagecache_size=128m
      # Do NOT add NEO4J_server_logs_user_stdout__enabled here. No such
      # setting exists in 5.26 — logging is configured by conf/user-logs.xml
      # (log4j2) — and strict validation rejects the unknown key, so Neo4j
      # refuses to boot and crash-loops on every install. Verified against
      # neo4j:5.26-community; see #39.
    volumes:
      - neo4j-data:/data
      # Declared explicitly so the logs land somewhere findable and prunable.
      # Undeclared, Docker mints a fresh anonymous volume, and `docker-compose
      # down` without -v leaves it dangling, so every down/up cycle leaks
      # another one.
      #
      # A full /logs is NOT fatal, and no log4j change is needed for it.
      # Measured on neo4j:5.26-community with the stock conf/*-logs.xml:
      # booted with /logs as a 100%-full tmpfs, and filled to 100% after
      # boot then loaded with 100k node writes, Neo4j logged "Unable to
      # write to stream /logs/..." and kept answering bolt and HTTP. log4j2
      # appenders already default to ignoreExceptions="true". That error in
      # #39 was a symptom of the full disk, not what stopped the database.
      # The likelier killer is the same full disk under /data (store and
      # transaction logs): Neo4j refused to start on a full /data in the
      # same test (runtime exhaustion of /data not tested). A read-only /logs also
      # exits, but in the image entrypoint's chown, before the JVM starts.
      # Rotation is handled by log4j2 inside the image (20 MB x 7).
      - neo4j-logs:/logs
    deploy:
      resources:
        limits:
          memory: 768M
    restart: unless-stopped
    # wget is present in this image. Probing the HTTP connector keeps the
    # check cheap; cypher-shell would prove query readiness but spawns a JVM
    # on every run, which does not fit the 768M limit.
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:7474/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s

  embeddings:
    build:
      context: .
      dockerfile: Dockerfile.embeddings
    container_name: ${COMPOSE_PROJECT}-embeddings
    ports:
      - "8090:8090"
    volumes:
      - model-cache:/root/.cache/huggingface
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    # python:3.11-slim has no curl or wget either; the interpreter is the
    # one thing guaranteed to be present. The long start_period covers the
    # first-run model download.
    healthcheck:
      test:
        - "CMD"
        - "python3"
        - "-c"
        - "import socket; socket.create_connection(('127.0.0.1', 8090), 2).close()"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 180s

volumes:
  qdrant-data:
  neo4j-data:
  neo4j-logs:
  model-cache:
